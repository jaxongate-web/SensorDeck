# Normalise line endings in the repo; check out with Windows endings where tools expect them.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.sln     text eol=crlf
*.props   text
*.ps1     text eol=crlf
*.iss     text eol=crlf
*.md      text
*.json    text

*.ico     binary
*.png     binary
