<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Release metadata (shown in the exe's Properties → Details and in the app's About section) -->
    <Version>1.0.0</Version>
    <Product>SensorDeck</Product>
    <Company>SensorDeck contributors</Company>
    <Description>SensorDeck — free, lightweight hardware monitor for Windows</Description>
    <Copyright>Copyright © 2026 SensorDeck contributors. MIT licence.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only ship English resource satellites (keeps the download small). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
