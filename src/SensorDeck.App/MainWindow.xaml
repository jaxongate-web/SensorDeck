<Window x:Class="SensorDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SensorDeck.App.Controls"
        xmlns:vm="clr-namespace:SensorDeck.App.ViewModels"
        xmlns:v="clr-namespace:SensorDeck.App.Views"
        Title="SensorDeck" Width="1240" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/SensorDeck.ico" Topmost="{Binding AlwaysOnTop}"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphsViewModel}">
            <v:GraphsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <v:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar ===== -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                    <c:Icon Data="{StaticResource IconLogo}" Width="16" Height="16" Foreground="White" StrokeThickness="2.4" />
                </Border>
                <TextBlock Text="SensorDeck" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise" AutomationProperties.Name="Minimise" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximise" AutomationProperties.Name="Maximise" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
            </StackPanel>

            <!-- ===== Navigation rail ===== -->
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,16,18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock Margin="15,6,0,0" FontSize="11" Foreground="{StaticResource DimBrush}">
                        <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · Free &amp; open source" />
                    </TextBlock>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MONITOR" Margin="26,6,0,8" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="{StaticResource IconDashboard}" IsChecked="True"
                                 Checked="Nav_Checked" CommandParameter="Dashboard" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Graphs" Tag="{StaticResource IconGraphs}"
                                 Checked="Nav_Checked" CommandParameter="Graphs" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Hardware" Tag="{StaticResource IconInfo}"
                                 Checked="Nav_Checked" CommandParameter="Hardware" />
                    <TextBlock Text="APP" Margin="26,18,0,8" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="{StaticResource IconSettings}"
                                 Checked="Nav_Checked" CommandParameter="Settings" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Content ===== -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12,0,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                <DockPanel>
                    <!-- Access banner: explains readings that are unavailable and how to enable them -->
                    <Border DockPanel.Dock="Top" Margin="28,22,28,0" Padding="14,10" CornerRadius="10"
                            Background="#14F59E0B" BorderBrush="#40F59E0B" BorderThickness="1"
                            Visibility="{Binding BannerText, Converter={StaticResource NullToVis}}">
                        <DockPanel>
                            <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="18" Height="18"
                                    Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Width="30" Height="28"
                                    FontSize="9" Command="{Binding DismissBannerCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="12,0,6,0"
                                    Content="{Binding BannerButtonText}" Command="{Binding BannerClickedCommand}"
                                    Visibility="{Binding BannerButtonText, Converter={StaticResource NullToVis}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                        </DockPanel>
                    </Border>

                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
