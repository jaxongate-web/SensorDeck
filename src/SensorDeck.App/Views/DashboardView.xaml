<UserControl x:Class="SensorDeck.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SensorDeck.App.Controls"
             xmlns:vm="clr-namespace:SensorDeck.App.ViewModels">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NotSupportedText" Color="#7A869A" />

        <!-- A single metric: label, big value + unit (or "Not supported" + reason), and a slim bar. -->
        <DataTemplate DataType="{x:Type vm:MetricViewModel}">
            <StackPanel Margin="0,0,16,0" Background="Transparent" ToolTip="{Binding Reason}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                <Grid Height="50" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource BigValue}"
                                   Foreground="{Binding Severity, Converter={StaticResource SeverityText}}" />
                        <TextBlock Text="{Binding Unit}" FontSize="14" Margin="4,0,0,6" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Not supported" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource NotSupportedText}" />
                        <TextBlock Text="{Binding Reason}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap" MaxHeight="30"
                                   TextTrimming="CharacterEllipsis" LineHeight="14" Foreground="{StaticResource DimBrush}" />
                    </StackPanel>
                </Grid>
                <ProgressBar Style="{StaticResource SlimBar}" Margin="0,10,0,0" Value="{Binding Fraction, Mode=OneWay}"
                             Foreground="{Binding Severity, Converter={StaticResource SeverityBar}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Header shared by cards: icon tile + title -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3,10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Power pill for CPU/GPU cards -->
        <DataTemplate x:Key="PowerPill" DataType="{x:Type vm:MetricViewModel}">
            <Border Style="{StaticResource Pill}" ToolTip="{Binding Reason}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource IconBolt}" Width="12" Height="12" Foreground="{StaticResource AccentLightBrush}" />
                    <TextBlock Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="ValueText" />
                                            <Binding Path="Unit" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                        <Setter Property="Text" Value="Power not supported" />
                                        <Setter Property="Foreground" Value="{StaticResource NotSupportedText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Big "used / total" style for memory cards -->
        <Style x:Key="MemValue" TargetType="TextBlock" BasedOn="{StaticResource BigValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Foreground" Value="{StaticResource NotSupportedText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="22,18,22,22">

            <!-- Page header -->
            <StackPanel Margin="6,4,6,10">
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Live readings from your hardware sensors" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="13" />
            </StackPanel>

            <!-- ===== Row 1: CPU + GPU ===== -->
            <UniformGrid Columns="2">
                <!-- CPU -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Cpu}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconTile}">
                                <c:Icon Data="{StaticResource IconCpu}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Power}" ContentTemplate="{StaticResource PowerPill}" Focusable="False" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DeviceFooter}">
                            <DockPanel>
                                <c:Icon Data="{StaticResource IconCpu}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="CPU" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <ContentControl Content="{Binding Temperature}" Focusable="False" />
                            <ContentControl Content="{Binding Usage}" Focusable="False" />
                            <ContentControl Content="{Binding Clock}" Focusable="False" />
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Gpu}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconTile}">
                                <c:Icon Data="{StaticResource IconGpu}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Power}" ContentTemplate="{StaticResource PowerPill}" Focusable="False" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DeviceFooter}">
                            <DockPanel>
                                <c:Icon Data="{StaticResource IconGpu}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="GPU" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <ContentControl Content="{Binding Temperature}" Focusable="False" />
                            <ContentControl Content="{Binding Usage}" Focusable="False" />
                            <ContentControl Content="{Binding Clock}" Focusable="False" />
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Row 2: RAM, VRAM, Fans ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Memory}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconTile}">
                                <c:Icon Data="{StaticResource IconMemory}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DeviceFooter}">
                            <DockPanel>
                                <c:Icon Data="{StaticResource IconMemory}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="RAM" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Top" ToolTip="{Binding Reason}" Background="Transparent">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="14"
                                           Foreground="{Binding Load.Severity, Converter={StaticResource SeverityText}}"
                                           Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding Load.ValueText, Mode=OneWay}" /><Run Text=" %" />
                                </TextBlock>
                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource MemValue}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding TotalText}" FontSize="14" Margin="6,0,0,6" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource DimBrush}"
                                       Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ProgressBar Style="{StaticResource SlimBar}" Margin="0,12,0,0" Value="{Binding Load.Fraction, Mode=OneWay}"
                                         Foreground="{Binding Load.Severity, Converter={StaticResource SeverityBar}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- VRAM -->
                <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding Vram}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Border Style="{StaticResource IconTile}">
                                <c:Icon Data="{StaticResource IconVram}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DeviceFooter}">
                            <DockPanel>
                                <c:Icon Data="{StaticResource IconGpu}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="VRAM" FontSize="11" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Top" ToolTip="{Binding Reason}" Background="Transparent">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="14"
                                           Foreground="{Binding Load.Severity, Converter={StaticResource SeverityText}}"
                                           Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding Load.ValueText, Mode=OneWay}" /><Run Text=" %" />
                                </TextBlock>
                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource MemValue}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding TotalText}" FontSize="14" Margin="6,0,0,6" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource DimBrush}"
                                       Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ProgressBar Style="{StaticResource SlimBar}" Margin="0,12,0,0" Value="{Binding Load.Fraction, Mode=OneWay}"
                                         Foreground="{Binding Load.Severity, Converter={StaticResource SeverityBar}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Fans -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Border Style="{StaticResource IconTile}">
                                <c:Icon Data="{StaticResource IconFan}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <TextBlock Text="FANS" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                   Visibility="{Binding FansNote, Converter={StaticResource NullToVis}}">
                            <c:Icon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{StaticResource DimBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding FansNote}" FontSize="11.5" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Fans}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FanViewModel}">
                                    <DockPanel Margin="0,6" Background="Transparent" ToolTip="{Binding Speed.Reason}">
                                        <c:Icon Data="{StaticResource IconFan}" Width="16" Height="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Speed.ValueText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Speed.Unit}" FontSize="11" Margin="4,0,0,1" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource DimBrush}">
                                                <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="{Binding DutyText, Mode=OneWay, StringFormat=' · {0}'}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== Row 3: Storage ===== -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Style="{StaticResource IconTile}">
                            <c:Icon Data="{StaticResource IconDrive}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                        </Border>
                        <TextBlock Text="STORAGE" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                               Visibility="{Binding DrivesNote, Converter={StaticResource NullToVis}}">
                        <c:Icon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{StaticResource DimBrush}" />
                        <TextBlock Text="{Binding DrivesNote}" FontSize="11.5" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <c:Icon Data="{StaticResource IconDrive}" Width="18" Height="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource DimBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0" ToolTip="{Binding UsedSpace.Reason}" Background="Transparent">
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                                <Run Text="{Binding UsedSpace.ValueText, Mode=OneWay}" /><Run Text=" % used" />
                                            </TextBlock>
                                            <ProgressBar Style="{StaticResource SlimBar}" Margin="0,6,0,0" Value="{Binding UsedSpace.Fraction, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                                    ToolTip="{Binding Temperature.Reason}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Visibility="{Binding Temperature.IsSupported, Converter={StaticResource BoolToVis}}">
                                                <c:Icon Data="{StaticResource IconThermo}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Temperature.ValueText}" FontSize="20" FontWeight="SemiBold"
                                                           Foreground="{Binding Temperature.Severity, Converter={StaticResource SeverityText}}" />
                                                <TextBlock Text="{Binding Temperature.Unit}" FontSize="12" Margin="3,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right"
                                                        Visibility="{Binding Temperature.IsSupported, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <TextBlock Text="Not supported" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource NotSupportedText}" />
                                                <TextBlock Text="{Binding Temperature.Reason}" FontSize="10.5" HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
