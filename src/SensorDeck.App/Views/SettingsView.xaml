<UserControl x:Class="SensorDeck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SensorDeck.App.Controls"
             xmlns:vm="clr-namespace:SensorDeck.App.ViewModels">

    <UserControl.Resources>
        <!-- Segmented choice control; Tag gives each control its own radio group -->
        <Style x:Key="Segmented" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border CornerRadius="8" Padding="3" Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="Margin" Value="6,16,0,0" />
        </Style>

        <!-- −/+ stepper -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="22,18,22,22" MaxWidth="980" HorizontalAlignment="Left">

            <StackPanel Margin="6,4,6,4">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Changes apply immediately and are saved automatically" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="13" />
            </StackPanel>

            <!-- Status message (save errors, startup changes, reset) -->
            <Border Margin="6,10,6,0" Padding="12,8" CornerRadius="8" Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#333B82F6" BorderThickness="1"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap" />
            </Border>

            <!-- ===== Display ===== -->
            <TextBlock Text="DISPLAY" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,6">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" Tag="unit" ItemsSource="{Binding TemperatureUnits}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Temperature unit" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Used on every page, graph and the tray tooltip" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" Tag="range" ItemsSource="{Binding GraphRanges}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Default graph range" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Time window the Graphs page opens with" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Monitoring ===== -->
            <TextBlock Text="MONITORING" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,6">
                <DockPanel Style="{StaticResource Row}">
                    <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" Tag="refresh" ItemsSource="{Binding RefreshRates}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Refresh interval" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="How often sensors are read. Faster updates use slightly more CPU; graph history adjusts automatically." Style="{StaticResource RowHint}" Margin="0,3,24,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Temperature warnings ===== -->
            <TextBlock Text="TEMPERATURE WARNINGS" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,8"
                               Text="Readings turn amber at the warm threshold and red at the hot threshold." />
                    <ItemsControl ItemsSource="{Binding Thresholds}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThresholdViewModel}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <DockPanel>
                                        <!-- Hot stepper -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource HotBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Hot" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding HotDownCommand}" AutomationProperties.Name="Decrease hot threshold" />
                                            <TextBlock Text="{Binding HotText}" Width="62" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding HotUpCommand}" AutomationProperties.Name="Increase hot threshold" />
                                        </StackPanel>
                                        <!-- Warm stepper -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Warm" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <Button Style="{StaticResource StepButton}" Content="−" Command="{Binding WarmDownCommand}" AutomationProperties.Name="Decrease warm threshold" />
                                            <TextBlock Text="{Binding WarmText}" Width="62" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Button Style="{StaticResource StepButton}" Content="+" Command="{Binding WarmUpCommand}" AutomationProperties.Name="Increase warm threshold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="17" Height="17" Foreground="{StaticResource AccentLightBrush}" />
                                            <TextBlock Text="{Binding Label}" Margin="10,0,0,0" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Window & startup ===== -->
            <TextBlock Text="WINDOW &amp; STARTUP" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,6">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Always on top" />
                        <StackPanel>
                            <TextBlock Text="Always on top" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Keep SensorDeck above other windows, e.g. while gaming in windowed mode" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Minimise to tray" />
                        <StackPanel>
                            <TextBlock Text="Minimise to tray" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Minimising hides the window to the notification area; hover the icon for live temperatures" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Close to tray" />
                        <StackPanel>
                            <TextBlock Text="Close to tray" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="The close button keeps SensorDeck running in the background; exit from the tray icon's menu" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start minimised" />
                        <StackPanel>
                            <TextBlock Text="Start minimised" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Open in the background (to the tray if a tray option is on)" Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanChangeStartup}" AutomationProperties.Name="Start with Windows" />
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding StartupHint}" Style="{StaticResource RowHint}" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== About ===== -->
            <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentGradient}">
                            <c:Icon Data="{StaticResource IconLogo}" Width="26" Height="26" Foreground="White" StrokeThickness="2.4" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="SensorDeck " /><Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="Free, open-source hardware monitor. No ads, no accounts, no telemetry — it never connects to the internet."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,14" />
                    <TextBlock Style="{StaticResource RowHint}" Margin="0">
                        <Run Text="Sensor readings by LibreHardwareMonitor " /><Run Text="{Binding LhmVersion, Mode=OneWay}" /><Run Text=" (MPL 2.0). CPU and motherboard sensors use the PawnIO driver when installed." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0">
                        <Run Text="Settings file: " /><Run Text="{Binding SettingsPath, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SubtleButton}" Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                        <Button Style="{StaticResource SubtleButton}" Content="LibreHardwareMonitor" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
                        <Button Style="{StaticResource SubtleButton}" Content="PawnIO driver" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://pawnio.eu/" />
                        <Button Style="{StaticResource SubtleButton}" Content="Reset to defaults" Margin="8,0,0,0" Command="{Binding ResetToDefaultsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
