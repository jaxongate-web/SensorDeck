<UserControl x:Class="SensorDeck.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SensorDeck.App.Controls"
             xmlns:vm="clr-namespace:SensorDeck.App.ViewModels">

    <UserControl.Resources>
        <SolidColorBrush x:Key="NotSupportedText" Color="#7A869A" />

        <!-- Access status tile -->
        <DataTemplate x:Key="StatusTile" DataType="{x:Type vm:StatusItem}">
            <Border Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,4,12,0" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Hint}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource DimBrush}"
                                   Visibility="{Binding Hint, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="22,18,22,22">

            <!-- Header -->
            <DockPanel Margin="6,4,6,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" VerticalAlignment="Center"
                        Command="{Binding CopySummaryCommand}" AutomationProperties.Name="Copy summary">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconCopy}" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding CopyButtonText}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Hardware" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Components detected on this PC and every sensor they expose" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="13" />
                </StackPanel>
            </DockPanel>

            <!-- Access status -->
            <UniformGrid Columns="3">
                <ContentControl Content="{Binding AdminStatus}" ContentTemplate="{StaticResource StatusTile}" Focusable="False" />
                <ContentControl Content="{Binding DriverStatus}" ContentTemplate="{StaticResource StatusTile}" Focusable="False" />
                <ContentControl Content="{Binding SensorStatus}" ContentTemplate="{StaticResource StatusTile}" Focusable="False" />
            </UniformGrid>

            <!-- Components -->
            <TextBlock Text="COMPONENTS" Margin="6,18,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
            <TextBlock Text="Detecting hardware…" Margin="6,6" Style="{StaticResource Caption}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><c:TwoColumnPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComponentCardViewModel}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="19" Height="19"
                                                Foreground="{StaticResource AccentLightBrush}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Details}" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Key}" Width="150" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Raw sensors -->
            <DockPanel Margin="6,18,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Hide sensors without a value" IsChecked="{Binding HideEmpty}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Grid Width="240">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6"
                                 AutomationProperties.Name="Search sensors" />
                        <c:Icon Data="{StaticResource IconSearch}" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0"
                                Foreground="{StaticResource DimBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="Search sensors" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="12.5" IsHitTestVisible="False"
                                   Foreground="{StaticResource DimBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </Grid>
                    <Button Style="{StaticResource SubtleButton}" Content="Expand / collapse" Margin="8,0,0,0" Command="{Binding ToggleAllCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ALL SENSORS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                    <TextBlock Text="Live values straight from LibreHardwareMonitor. “No value” means the sensor exists but this system doesn't report it."
                               FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Loading sensors…" Margin="6" Style="{StaticResource Caption}"
                       Visibility="{Binding HasSensors, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RawSensorGroup}">
                        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Group header (click to expand/collapse) -->
                                <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                              Foreground="{StaticResource TextBrush}"
                                              AutomationProperties.Name="{Binding HardwareName}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent" Padding="16,12" CornerRadius="12">
                                                <DockPanel>
                                                    <c:Icon x:Name="Chev" DockPanel.Dock="Right" Data="{StaticResource IconChevron}" Width="14" Height="14"
                                                            Foreground="{StaticResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                                                        <c:Icon.RenderTransform><RotateTransform Angle="-90" /></c:Icon.RenderTransform>
                                                    </c:Icon>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11.5" Margin="0,0,12,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="17" Height="17"
                                                            Foreground="{StaticResource AccentLightBrush}" />
                                                    <TextBlock Text="{Binding HardwareName}" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chev" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Rows -->
                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="16,0,16,10">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TYPE" FontSize="10.5" Foreground="{StaticResource DimBrush}" />
                                        <TextBlock Grid.Column="1" Text="SENSOR" FontSize="10.5" Foreground="{StaticResource DimBrush}" />
                                        <TextBlock Grid.Column="2" Text="VALUE" FontSize="10.5" HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}" />
                                        <TextBlock Grid.Column="3" Text="MIN" FontSize="10.5" HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}" />
                                        <TextBlock Grid.Column="4" Text="MAX" FontSize="10.5" HorizontalAlignment="Right" Foreground="{StaticResource DimBrush}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RawSensorRow}">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,5"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Background="{StaticResource RaisedBrush}">
                                                            <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource NotSupportedText}" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding MinText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding MaxText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
